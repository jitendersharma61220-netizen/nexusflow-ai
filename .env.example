# Groq LLM (required for live AI responses — get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Supabase Postgres (optional — leave blank to run on local SQLite storage instead)
SUPABASE_URL=
SUPABASE_KEY=

# When true, forces local SQLite storage even if Supabase credentials are present.
# Set to false for a persistent client-facing deployment with Supabase configured.
DEMO_MODE=true
